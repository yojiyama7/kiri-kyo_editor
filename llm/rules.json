{
  "version": 1,
  "updated": "2026-08-18",
  "rules": [
    {"id":"IN-01","domain":"input","decision":"tokenization","when":{},"outcome":"whitespace","text":"入力テキストを空白区切りでtoken化する。"},
    {"id":"IN-02","domain":"input","decision":"sentence-boundary","when":{},"outcome":"newline","text":"改行を文境界として扱う。"},
    {"id":"IN-03","domain":"input","decision":"cross-sentence-structure","when":{"kind":["group","T","arrow"]},"outcome":"forbidden","text":"group、T、矢印は文境界を跨げない。"},
    {"id":"IN-04","domain":"input","decision":"text-resync","when":{},"outcome":"preserve-by-index-when-valid","text":"英文編集時は同じindexの標識と構造を妥当な範囲で維持する。"},
    {"id":"IN-05","domain":"input","decision":"saved-index-scope","when":{},"outcome":"sentence-local-zero-based","text":"inner_jsonのtokenと境界indexは文ごとに0から振る。"},

    {"id":"SL-01","domain":"slot","decision":"single-shape","when":{"kind":"single"},"outcome":"text","text":"single slotはtextを1つ持つ。"},
    {"id":"SL-02","domain":"slot","decision":"double-shape","when":{"kind":"double"},"outcome":"left-right","text":"double slotは独立したleft/rightを持つ。"},
    {"id":"SL-03","domain":"slot","decision":"T-shape","when":{"owner":["token","group"]},"outcome":"left-right","text":"token Tとgroup Tは独立したleft/right slotを持つ。"},
    {"id":"SL-04","domain":"slot","decision":"hidden-original-slot","when":{"hidden-by":"T"},"outcome":"retain-disabled","text":"Tで隠れる元slotは値を保持したまま無効化する。"},
    {"id":"SL-05","domain":"slot","decision":"hidden-slot-save","when":{"hidden-by":"T"},"outcome":"persist","text":"現在非表示の元slotもinner_jsonから復元可能にする。"},
    {"id":"SL-06","domain":"slot","decision":"geometry-source","when":{"is-slot":true},"outcome":"calculateSlotGeometry","text":"全slot矩形は純粋関数calculateSlotGeometryで算出する。"},
    {"id":"SL-07","domain":"slot","decision":"geometry-layouts","when":{},"outcome":"single-double-t-underline","text":"geometry layoutはsingle、double-pair、t-pair、underlineとする。"},
    {"id":"SL-08","domain":"slot","decision":"geometry-height","when":{"cursor-kind":["normal","selection","fixed"]},"outcome":"20px","text":"全slotカーソルの外形高さを20pxに統一する。"},
    {"id":"SL-09","domain":"slot","decision":"geometry-border","when":{"cursor-kind":["normal","selection","fixed"]},"outcome":"visible-2px","text":"青、灰、オレンジの全slotカーソルに2pxの可視borderを表示する。"},
    {"id":"SL-10","domain":"slot","decision":"geometry-exclusion","when":{"kind":["BORDER-position-cursor","dummy"]},"outcome":"not-slot-geometry","text":"BORDER位置カーソルと文末dummyはslot geometryの対象外とする。"},
    {"id":"SL-11","domain":"slot","decision":"cursor-count","when":{"mode":"NORMAL"},"outcome":"one-blue","text":"通常青カーソルは常に1つだけ表示する。"},

    {"id":"SQ-01","domain":"sequence","decision":"surface-order-source","when":{},"outcome":"createTokenSequence","text":"通常tokenと疑似tokenの表面順はcreateTokenSequenceを正本とする。"},
    {"id":"SQ-02","domain":"sequence","decision":"surface-elements","when":{},"outcome":"token-or-pseudo-token","text":"共通列の要素はtokenまたはpseudo-tokenとする。"},
    {"id":"SQ-03","domain":"sequence","decision":"surface-consumers","when":{},"outcome":"selection-navigation-border-render","text":"V選択、葉順、隣接、行候補、BORDER、描画順を共通列から導出する。"},
    {"id":"SQ-04","domain":"sequence","decision":"slot-expansion-stage","when":{"kind":"token"},"outcome":"after-surface-order","text":"single/double/T左右への展開は共通列要素を得た後に行う。"},
    {"id":"SQ-05","domain":"sequence","decision":"duplicate-order-model","when":{},"outcome":"forbidden","text":"通常tokenと疑似tokenを別走査して同じ表面順を再構築しない。"},

    {"id":"GR-01","domain":"group","decision":"semantic-source","when":{},"outcome":"members","text":"groupの意味構造の正本は直接選択したslot参照membersとする。"},
    {"id":"GR-02","domain":"group","decision":"derived-cache","when":{},"outcome":"segments-start-end","text":"segments、start、endはmembersから導出する描画キャッシュとする。"},
    {"id":"GR-03","domain":"group","decision":"minimum-size","when":{"operation":"commit"},"outcome":"at-least-2-slots","text":"V groupは合計2slot以上で確定する。"},
    {"id":"GR-04","domain":"group","decision":"membership","when":{},"outcome":"exact-selected-refs","text":"group所属は選択した正確なslot参照だけで決める。"},
    {"id":"GR-05","domain":"group","decision":"membership-inference","when":{},"outcome":"forbidden","text":"range、同一境界、近接関係から未選択memberを補完しない。"},
    {"id":"GR-06","domain":"group","decision":"allowed-relations","when":{},"outcome":"overlap-containment-equal-range","text":"重なり、包含、同一範囲のgroupを許す。"},
    {"id":"GR-07","domain":"group","decision":"own-slot","when":{"form":"underline"},"outcome":"single","text":"非T group自身はsingle標識slotを持つ。"},
    {"id":"GR-08","domain":"group","decision":"T-conversion","when":{"operation":"t"},"outcome":"group-T","text":"groupをtで左右slotを持つTへ変換する。"},
    {"id":"GR-09","domain":"group","decision":"X-on-group-T","when":{"operation":"X","form":"T"},"outcome":"remove-T-only","text":"Xはgroup TではTだけを外す。"},
    {"id":"GR-10","domain":"group","decision":"X-on-underline","when":{"operation":"X","form":"underline"},"outcome":"remove-group","text":"Xは通常V下線ではgroupを削除する。"},
    {"id":"GR-11","domain":"group","decision":"U","when":{"operation":"U"},"outcome":"remove-group","text":"Uは現在のgroupを解除して削除する。"},
    {"id":"GR-12","domain":"group","decision":"U-dangling-ref","when":{"nested":true},"outcome":"expand-direct-members","text":"Uで子groupを削除した親参照は子の直接membersへ展開する。"},
    {"id":"GR-13","domain":"group","decision":"noncontiguous-render","when":{"selected-runs":"multiple"},"outcome":"multiple-underlines","text":"非連続memberは複数の下線区間として描画する。"},
    {"id":"GR-14","domain":"group","decision":"noncontiguous-link","when":{"selected-runs":"multiple"},"outcome":"colored-inner-end-marks","text":"分割下線の内側端を同色マークで間接接続する。"},
    {"id":"GR-15","domain":"group","decision":"link-color-storage","when":{},"outcome":"display-only","text":"分割下線の対応色はdisplay_jsonで決め、保存状態へ入れない。"},
    {"id":"GR-16","domain":"group","decision":"pseudo-membership","when":{"kind":"pseudo-token"},"outcome":"boundary-and-index-exact","text":"疑似token memberは境界indexとpseudoIndexの両方を保持する。"},
    {"id":"GR-17","domain":"group","decision":"T-side-membership","when":{"owner":"group-T","port":["left","right"]},"outcome":"independent-primitive","text":"group Tのleft/rightは別groupへ片側だけ含められる独立基礎slotとする。"},

    {"id":"PS-01","domain":"pseudo-token","decision":"count-per-gap","when":{},"outcome":"zero-or-more","text":"1境界に疑似tokenを0個以上連続配置できる。"},
    {"id":"PS-02","domain":"pseudo-token","decision":"shape","when":{},"outcome":"surface-text-plus-single-slot","text":"疑似tokenは表面文字列とsingle slotを1つ持つ。"},
    {"id":"PS-03","domain":"pseudo-token","decision":"source-text","when":{},"outcome":"unchanged","text":"疑似tokenは原文textを変更しない。"},
    {"id":"PS-04","domain":"pseudo-token","decision":"surface-color","when":{},"outcome":"#800020","text":"疑似tokenの表面文字列を臙脂色で表示する。"},
    {"id":"PS-05","domain":"pseudo-token","decision":"behavior","when":{},"outcome":"same-as-single-token-except-color","text":"色以外は通常tokenのsingle slotと同じ選択・移動・構造挙動を持つ。"},
    {"id":"PS-06","domain":"pseudo-token","decision":"shared-newline-gap-owner","when":{"gap":"shared-newline"},"outcome":"preceding-sentence","text":"改行共有境界の疑似tokenは描画される改行前の文へ所属する。"},
    {"id":"PS-07","domain":"pseudo-token","decision":"click","when":{},"outcome":"NORMAL-select-slot","text":"疑似tokenクリックはNORMALへ戻してそのslotを選択する。"},
    {"id":"PS-08","domain":"pseudo-token","decision":"BORDER-insert","when":{"mode":"BORDER","key":"/"},"outcome":"insert-new-and-stay","text":"BORDER中の/は新規疑似tokenを挿入し、確定後もBORDERに留まる。"},
    {"id":"PS-09","domain":"pseudo-token","decision":"BORDER-delete","when":{"mode":"BORDER","key":"Backspace"},"outcome":"delete-one-before-cursor","text":"BORDER中のBackspaceは直前の疑似token1個だけを削除する。"},
    {"id":"PS-10","domain":"pseudo-token","decision":"reference-reindex","when":{"operation":["insert","delete"]},"outcome":"pure-rewrite","text":"挿入削除時はgroupと矢印のpseudoIndexを純粋関数で補正する。"},
    {"id":"PS-11","domain":"pseudo-token","decision":"edit-surface","when":{"mode":"NORMAL","key":"e"},"outcome":"edit-label","text":"疑似token選択中のeは表面文字列を編集する。"},
    {"id":"PS-12","domain":"pseudo-token","decision":"edit-slot","when":{"mode":"NORMAL","key":"/"},"outcome":"edit-single-slot","text":"疑似token選択中の/はslot内容を編集する。"},
    {"id":"PS-13","domain":"pseudo-token","decision":"BORDER-position-count","when":{"count":"n-at-gap"},"outcome":"n-plus-1","text":"n個の疑似tokenがある境界は前・間・後のn+1位置を持つ。"},
    {"id":"PS-14","domain":"pseudo-token","decision":"BORDER-exit","when":{"right-surface":"exists"},"outcome":"select-exact-right-surface","text":"BORDER終了時は直右の通常または疑似tokenへ戻る。"},
    {"id":"PS-15","domain":"pseudo-token","decision":"BORDER-exit","when":{"right-surface":"none-document-end"},"outcome":"select-last-surface","text":"文書末で直右要素がない場合だけ最後のsurface tokenへ戻る。"},

    {"id":"BD-01","domain":"boundary-slot","decision":"ownership","when":{"symbol":"["},"outcome":"single-slot-by-character-index","text":"[は境界文字列内の出現位置ごとにsingle slotを1つ持つ。"},
    {"id":"BD-02","domain":"boundary-slot","decision":"selection","when":{"symbol":"[","operation":["create-normal","click"]},"outcome":"select-boundary-slot","text":"NORMALで[を作成した直後とクリック時は、その境界slotを選択する。"},
    {"id":"BD-03","domain":"boundary-slot","decision":"mark-input","when":{"symbol":"["},"outcome":"normal-mark-language","text":"[の境界slotには通常の標識キー列で働きの標識を入力できる。"},
    {"id":"BD-04","domain":"boundary-slot","decision":"persistence","when":{"symbol":"["},"outcome":"boundarySlots-local-gap-and-character-index","text":"[の境界slotは文ローカル境界indexと境界文字列内indexでinner_jsonへ保存する。"},
    {"id":"BD-05","domain":"boundary-slot","decision":"horizontal-movement","when":{"symbol":"["},"outcome":"adjacent-visible-slot","text":"[の境界slotのh/lは表示順で隣接する境界slot、疑似token、通常tokenへ移動する。"},
    {"id":"BD-06","domain":"boundary-symbol","decision":"ownership","when":{"symbol":"<"},"outcome":"no-slot","text":"<はslotを持たない。"},
    {"id":"BD-07","domain":"boundary-symbol","decision":"arrow-source","when":{"mode":"BORDER","key":"r","current-gap-contains":"<"},"outcome":"last-less-than-starts-arrow","text":"BORDERのrは現在境界で最後の<自体を始点に矢印選択へ移る。"},

    {"id":"AR-01","domain":"arrow","decision":"source-eligibility","when":{},"outcome":"slotless-less-than-or-a-ad-adverbial-object-apposition","text":"矢印始点はBORDERで指定したslotなしの<、またはa、ad、副詞的目的格、同格の有効slotに限る。"},
    {"id":"AR-02","domain":"arrow","decision":"create-command","when":{"key":"r"},"outcome":"start-draft","text":"rで現在slotを始点に矢印作成を開始する。"},
    {"id":"AR-03","domain":"arrow","decision":"commit-command","when":{"draft":true,"key":"Enter"},"outcome":"commit","text":"矢印選択中のEnterで終点を確定する。"},
    {"id":"AR-04","domain":"arrow","decision":"target-eligibility","when":{},"outcome":"enabled-token-pseudo-or-group-slot","text":"終点には通常token、疑似token、groupの有効slotを指定できる。"},
    {"id":"AR-05","domain":"arrow","decision":"max-per-source","when":{},"outcome":"one-replace-existing","text":"1始点につき矢印は1本とし、新規確定で付け替える。"},
    {"id":"AR-06","domain":"arrow","decision":"cross-sentence","when":{},"outcome":"forbidden","text":"矢印は文境界を跨げない。"},
    {"id":"AR-07","domain":"arrow","decision":"delete-command","when":{"key":"R"},"outcome":"delete-from-current-source","text":"Rで現在slot始点の矢印を削除する。"},
    {"id":"AR-08","domain":"arrow","decision":"cleanup","when":{"endpoint":"invalid-or-source-mark-ineligible"},"outcome":"delete","text":"端点無効化または始点標識不適格時に矢印を削除する。"},
    {"id":"AR-09","domain":"arrow","decision":"empty-underlined-target-y","when":{"target":"empty-slot-inside-underline"},"outcome":"top-minus-1px","text":"下線内の空slot終点では矢印先端をslot上端の1px上へ置く。"},
    {"id":"AR-10","domain":"arrow","decision":"ordinary-target-y","when":{"target":"other"},"outcome":"bottom-plus-1px","text":"空下線内slot以外の終点では従来どおり下端を使う。"},
    {"id":"AR-11","domain":"arrow","decision":"pseudo-row","when":{"endpoint":"pseudo-token"},"outcome":"actual-DOM-row","text":"疑似token端点の行は実DOMの表示行から求める。"},
    {"id":"AR-12","domain":"arrow","decision":"lane-conflict","when":{"x-overlap":true,"base-y-overlap":true},"outcome":"separate-by-12px","text":"水平範囲と実Yが重なる矢印だけ12px単位で別レーンへ送る。"},
    {"id":"AR-13","domain":"arrow","decision":"lane-conflict","when":{"x-overlap":true,"base-y-overlap":false},"outcome":"share-level","text":"水平範囲が重なっても実Yが異なる矢印は同じlevelを使う。"},
    {"id":"AR-14","domain":"arrow","decision":"lane-underline-obstacle","when":{"horizontal-x-overlap":true,"lane-y":"inside-underline-and-mark-band","group-contains-both-endpoints":false},"outcome":"advance-by-12px-until-clear","text":"矢印の水平線が無関係な下線および直下group標識帯とX方向に重なる場合、その帯を抜けるまで12px刻みで下のレーンへ送る。両端を含むgroup自身の帯と縦線交差は判定に含めない。"},
    {"id":"AR-15","domain":"arrow","decision":"lane-underline-obstacle","when":{"group-contains-both-endpoints":true},"outcome":"ignore-own-containing-band","text":"矢印の両端を再帰的に含むgroupの下線帯は、その内部矢印自身のレーン障害物にしない。"},

    {"id":"MV-01","domain":"movement","decision":"horizontal-engine","when":{"mode":["NORMAL","V"]},"outcome":"shared-target-calculation","text":"NORMALとV選択中のh/lは同じ移動先計算を使う。"},
    {"id":"MV-02","domain":"movement","decision":"grid-column","when":{"ref":"leaf-slot"},"outcome":"surface-leaf-index","text":"葉slot順をcol_idxとする。"},
    {"id":"MV-03","domain":"movement","decision":"grid-column","when":{"ref":"multi-leaf-group-slot"},"outcome":"minimum-contained-column","text":"複数葉を含むgroup slotのcol_idxは最小包含列とする。"},
    {"id":"MV-04","domain":"movement","decision":"horizontal-grid-choice","when":{},"outcome":"nearest-at-max-row-not-below-current","text":"h/lは方向側候補のうち現在row以下で最大rowの最寄りを選ぶ。"},
    {"id":"MV-05","domain":"movement","decision":"horizontal-entry-priority","when":{"case":"same-height-visible-adjacent-token"},"outcome":"token-slot","text":"隣group内tokenに実表示slotが同じ高さにあれば、直接兄弟groupよりtoken slotを優先する。"},
    {"id":"MV-06","domain":"movement","decision":"horizontal-entry-priority","when":{"case":"adjacent-empty-group"},"outcome":"group-self","text":"隣group内部が完全に空なら外からはgroup自身へ入る。"},
    {"id":"MV-07","domain":"movement","decision":"horizontal-entry-priority","when":{"case":"explicit-child-reference"},"outcome":"group-single-slot-even-empty","text":"同じ高さの実token候補がなく、明示的な非T子group参照を選ぶ場合は空でもsingle group slotを選ぶ。"},
    {"id":"MV-08","domain":"movement","decision":"horizontal-entry-priority","when":{"case":"direct-siblings-without-same-height-visible-token"},"outcome":"direct-member-before-descendant-leaf","text":"同じ高さの実token候補がない場合だけ、親groupの直接兄弟memberを方向側の内側葉より優先する。"},
    {"id":"MV-09","domain":"movement","decision":"horizontal-entry-priority","when":{"case":"same-contiguous-underline-segment-leaf-fallback"},"outcome":"nearest-leaf-in-same-segment","text":"上記候補がない場合、同じ連続下線区間の方向側葉slotを空でも優先する。"},
    {"id":"MV-10","domain":"movement","decision":"top-level-groups","when":{"relation":"same-sentence-top-level"},"outcome":"implicit-root-siblings","text":"最上位group同士を文の暗黙rootの兄弟としてh/l移動対象にする。"},
    {"id":"MV-11","domain":"movement","decision":"pair-vs-pseudo","when":{"position":"inside-double-or-T"},"outcome":"paired-slot-first","text":"double/T内部の左右移動を隣接疑似tokenより優先する。"},
    {"id":"MV-12","domain":"movement","decision":"pair-vs-pseudo","when":{"position":"outside-edge"},"outcome":"adjacent-pseudo-next","text":"double/T外側slotから進んだとき疑似tokenへ出る。"},
    {"id":"MV-13","domain":"movement","decision":"group-exit-pseudo","when":{"pseudo":"outside-group"},"outcome":"nearest-surface-neighbor","text":"groupから出るとき外部の隣接疑似tokenを通常tokenより先に選ぶ。"},
    {"id":"MV-14","domain":"movement","decision":"group-exit-pseudo","when":{"pseudo":"recursive-member"},"outcome":"not-external-candidate","text":"group内部memberの疑似tokenは外部候補にしない。"},
    {"id":"MV-15","domain":"movement","decision":"vertical-column","when":{},"outcome":"preserve-last-horizontal-col","text":"j/kは最後の横移動で決まったcol_idxを維持する。"},
    {"id":"MV-16","domain":"movement","decision":"vertical-down","when":{"structural-target":"exists"},"outcome":"one-level-down-same-column","text":"jは同列の外側構造へ一段下がる。"},
    {"id":"MV-17","domain":"movement","decision":"vertical-up","when":{"structural-target":"exists"},"outcome":"one-level-up-same-column","text":"kは同列の子groupまたは内部slotへ一段上がる。"},
    {"id":"MV-18","domain":"movement","decision":"line-fallback","when":{"key":"j","structural-target":"none","mode":"NORMAL"},"outcome":"next-line-nearest-x","text":"NORMALで下構造がなければjは次行の表示X最寄りslotへ移る。"},
    {"id":"MV-19","domain":"movement","decision":"line-fallback","when":{"key":"k","structural-target":"none","mode":"NORMAL"},"outcome":"previous-line-nearest-x","text":"NORMALで上構造がなければkは前行の表示X最寄りslotへ移る。"},
    {"id":"MV-20","domain":"movement","decision":"line-fallback","when":{"mode":"V"},"outcome":"disabled","text":"文跨ぎgroupを避けるためV選択中は行フォールバックしない。"},
    {"id":"MV-21","domain":"movement","decision":"line-edge","when":{"key":"0"},"outcome":"first-surface-on-current-line","text":"0は疑似tokenを含む現在行最初のsurfaceへ移る。"},
    {"id":"MV-22","domain":"movement","decision":"line-edge","when":{"key":"$"},"outcome":"last-surface-on-current-line","text":"$は疑似tokenを含む現在行最後のsurfaceへ移る。"},
    {"id":"MV-23","domain":"movement","decision":"horizontal-entry-priority","when":{"case":"line-crossing-visible-boundary-token"},"outcome":"token-slot","text":"h/lで行境界を跨ぐとき、境界側tokenに実表示slotがあれば内包groupのslotよりtoken slotを優先する。"},
    {"id":"MV-24","domain":"movement","decision":"noncontiguous-gap-exit","when":{"current":"inner-edge-of-noncontiguous-segment","adjacent":"unselected-slot-in-gap"},"outcome":"adjacent-slot-even-empty","text":"非連続下線の区間内側端からh/lすると、別区間へ飛ばず隣接する未所属gap slotへ空でも移動する。"},

    {"id":"VS-01","domain":"V-selection","decision":"selection-source","when":{},"outcome":"visited-path","text":"V選択の正本は開始終了rangeではなく実際に通過したslot pathとする。"},
    {"id":"VS-02","domain":"V-selection","decision":"backtrack","when":{"candidate":"already-in-current-path"},"outcome":"truncate-to-candidate","text":"直前方向へ戻った場合はpathをその位置まで縮める。"},
    {"id":"VS-03","domain":"V-selection","decision":"compression-time","when":{"operation":"commit"},"outcome":"compress-adjacent-runs","text":"確定時だけ選択slotを表示順上の連続区間へ圧縮する。"},
    {"id":"VS-04","domain":"V-selection","decision":"segment-toggle","when":{"key":"V","selecting":true},"outcome":"fix-current-path","text":"選択中のVで現在pathを固定区間にする。"},
    {"id":"VS-05","domain":"V-selection","decision":"segment-toggle","when":{"key":"V","selecting":false},"outcome":"start-new-path","text":"区間固定後のVで現在位置から新しいpathを始める。"},
    {"id":"VS-06","domain":"V-selection","decision":"escape","when":{},"outcome":"cancel-without-group","text":"EscはV選択をgroup作成なしで終了する。"},
    {"id":"VS-07","domain":"V-selection","decision":"vertical-availability","when":{},"outcome":"j-k-always-available-within-sentence","text":"active/fixed区間の有無にかかわらずV選択中もj/kを使える。"},
    {"id":"VS-08","domain":"V-selection","decision":"cursor-visual","when":{"state":"active"},"outcome":"gray","text":"V選択現在位置を灰色カーソルで表示する。"},
    {"id":"VS-09","domain":"V-selection","decision":"cursor-visual","when":{"state":"fixed"},"outcome":"orange","text":"固定済みV区間をオレンジカーソルで表示する。"},

    {"id":"DP-01","domain":"display","decision":"underline-base-order","when":{"relation":"contains"},"outcome":"contained-above-container","text":"包含される短いgroupを包むgroupより上に置く。"},
    {"id":"DP-02","domain":"display","decision":"underline-base-order","when":{"relation":"overlap-no-containment"},"outcome":"shorter-above","text":"包含関係のない重なりgroupは短い方を上に置く。"},
    {"id":"DP-03","domain":"display","decision":"underline-spacing","when":{"overlap":true},"outcome":"27px","text":"重なる下線とT横線を上から27px固定間隔で置く。"},
    {"id":"DP-04","domain":"display","decision":"underline-segments","when":{"selected-leaves":"contiguous"},"outcome":"one-line","text":"再帰的な選択葉が連続する部分を1本の下線にする。"},
    {"id":"DP-05","domain":"display","decision":"underline-segments","when":{"selected-leaves":"gap-by-unselected-leaf"},"outcome":"split-lines","text":"未選択葉が間にある場合は下線を分割する。"},
    {"id":"DP-06","domain":"display","decision":"cursor-clearance","when":{"cursor":"inside-group"},"outcome":"line-below-visible-cursor-bottom","text":"group内部に色を問わずカーソルがあれば下線をその可視下端より下へ置く。"},
